{
  "name": "ReceptMeneger",
  "image": "ghcr.io/thephaseless/devcontainers/flutter:latest",
  "forwardPorts": [8081],
  "portsAttributes": {
    "8081": {
      "label": "Flutter web",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ]
    }
  }
}
